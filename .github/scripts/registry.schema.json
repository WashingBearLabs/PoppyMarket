{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PoppyMarket registry.json",
  "description": "Structural schema for registry.json, for editors and docs. It cannot express: a theme name equal to its repo suffix and preview directory, reserved names, duplicate or conflicting entries, control and bidi characters in display text, file existence, canonical formatting, or the online checks. scripts/poppymarket/validate_registry.py is the authority and also enforces those.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated_at",
    "apps"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "apps": {
      "type": "array",
      "items": {
        "if": {
          "properties": {
            "kind": {
              "const": "theme"
            }
          },
          "required": [
            "kind"
          ]
        },
        "then": {
          "$ref": "#/$defs/theme"
        },
        "else": {
          "$ref": "#/$defs/app"
        }
      }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "description": "A theme entry (kind: theme). Keys outside this list are refused.",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "description",
        "version",
        "author",
        "repo_url",
        "ref",
        "preview_image"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "kind": {
          "const": "theme"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "long_description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "maxLength": 64
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "repo_url": {
          "type": "string",
          "pattern": "^https://github\\.com/WashingBearLabs/poppy-theme-[a-z0-9][a-z0-9-]{0,62}(\\.git)?$"
        },
        "ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "preview_image": {
          "type": "string",
          "pattern": "^themes/[a-z0-9][a-z0-9-]{0,62}/preview\\.(png|jpg|jpeg|webp)$"
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 32
          }
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        }
      }
    },
    "app": {
      "type": "object",
      "description": "An app entry (kind absent or 'app'). Needs a non-empty image or repo_url.",
      "required": [
        "name",
        "description",
        "version",
        "author"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "kind": {
          "enum": [
            "app"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "long_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "hero_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "use_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": false,
        "_source": false
      },
      "anyOf": [
        {
          "required": [
            "image"
          ],
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "repo_url"
          ],
          "properties": {
            "repo_url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
